func (c *{{.ClientName}}Client) makeRequest(ctx context.Context, method, path string, body io.Reader) (*http.Response, error) {
	url := fmt.Sprintf("%s%s", c.baseURL, path)
	
	// Retry logic with exponential backoff
	maxRetries := 3
	var lastErr error
	
	for attempt := 0; attempt < maxRetries; attempt++ {
		if attempt > 0 {
			// Exponential backoff: 1s, 2s, 4s
			backoff := time.Second * time.Duration(1<<uint(attempt-1))
			c.logger.Info("Retrying request with backoff", 
				zap.Int("attempt", attempt+1),
				zap.Int("maxRetries", maxRetries),
				zap.Duration("backoff", backoff))
			time.Sleep(backoff)
		}
		
		req, err := http.NewRequestWithContext(ctx, method, url, body)
		if err != nil {
			c.logger.Error("Failed to create request", zap.Error(err))
			return nil, err
		}

		req.Header.Set("Content-Type", "application/json")

		c.logger.Info("Making API request", 
			zap.String("method", method), 
			zap.String("url", url),
			zap.Int("attempt", attempt+1))

		resp, err := c.httpClient.Do(req)
		if err != nil {
			c.logger.Error("Request failed", zap.Error(err))
			lastErr = err
			continue
		}

		if resp.StatusCode >= 500 {
			// Retry on server errors
			c.logger.Warn("Server error, will retry", 
				zap.Int("status", resp.StatusCode))
			lastErr = fmt.Errorf("API server error: %d", resp.StatusCode)
			resp.Body.Close()
			continue
		}
		
		if resp.StatusCode >= 400 {
			c.logger.Error("API returned client error", 
				zap.Int("status", resp.StatusCode))
			resp.Body.Close()
			return nil, fmt.Errorf("API client error: %d", resp.StatusCode)
		}

		return resp, nil
	}
	
	return nil, fmt.Errorf("request failed after %d attempts: %w", maxRetries, lastErr)
}

func (c *{{.ClientName}}Client) encodeBody(body interface{}) (io.Reader, error) {
	if body == nil {
		return nil, nil
	}
	
