// Test{{.EntityName}}Repository_Create tests the Create method
func Test{{.EntityName}}Repository_Create(t *testing.T) {
	tests := []struct {
		name    string
		entity  *domain.{{.EntityName}}
		setup   func(*MyMockedObject)
		wantErr bool
	}{
		{
			name: "successful create",
			entity: &domain.{{.EntityName}}{
				// Initialize entity fields
			},
			setup: func(m *MyMockedObject) {
				m.On("InsertOne", mock.Anything, mock.Anything, mock.Anything).Return(&mongo.InsertOneResult{}, nil)
			},
			wantErr: false,
		},
		{
			name: "create with error",
			entity: &domain.{{.EntityName}}{
				// Initialize entity fields
			},
			setup: func(m *MyMockedObject) {
				m.On("InsertOne", mock.Anything, mock.Anything, mock.Anything).Return(nil, errors.New("database error"))
			},
			wantErr: true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			mockCollection := new(MyMockedObject)
			if tt.setup != nil {
				tt.setup(mockCollection)
			}

			repo := &{{.EntityName}}Repository{
				collection: mockCollection,
				logger:     zap.NewNop(),
			}

			ctx := context.Background()
			err := repo.Create(ctx, tt.entity)

			if tt.wantErr {
				assert.Error(t, err)
			} else {
				require.NoError(t, err)
			}
		})
	}
}

// Test{{.EntityName}}Repository_Delete tests the Delete method
func Test{{.EntityName}}Repository_Delete(t *testing.T) {
	tests := []struct {
		name    string
		id      string
		setup   func(*MyMockedObject)
		wantErr bool
	}{
		{
			name: "successful delete",
			id:   "entity-1",
