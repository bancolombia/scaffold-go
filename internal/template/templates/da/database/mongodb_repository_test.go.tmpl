				m.On("DeleteOne", mock.Anything, mock.Anything, mock.Anything).Return(&mongo.DeleteResult{DeletedCount: 1}, nil)
			},
			wantErr: false,
		},
		{
			name: "delete with error",
			id:   "entity-2",
			setup: func(m *MyMockedObject) {
				m.On("DeleteOne", mock.Anything, mock.Anything, mock.Anything).Return(nil, errors.New("database error"))
			},
			wantErr: true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			mockCollection := new(MyMockedObject)
			if tt.setup != nil {
				tt.setup(mockCollection)
			}

			repo := &{{.EntityName}}Repository{
				collection: mockCollection,
				logger:     zap.NewNop(),
			}

			ctx := context.Background()
			err := repo.Delete(ctx, tt.id)

			if tt.wantErr {
				assert.Error(t, err)
