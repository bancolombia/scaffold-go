// minimal interface for database operations used by {{.EntityName}}Repository
// This interface abstracts the database operations required by the {{.EntityName}}Repository.
// It allows for easier testing and decouples the repository from a specific database implementation.
// ADD ADITIONAL METHODS AS NEEDED
type I{{.EntityName}}RepositoryDbRepo interface {
	Exec(ctx context.Context, sql string, arguments ...any) (pgconn.CommandTag, error)
	Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error)
	QueryRow(ctx context.Context, sql string, args ...any) pgx.Row
}

type {{.EntityName}}Repository struct {
	pool I{{.EntityName}}RepositoryDbRepo
	logger 	*zap.Logger
}

func New{{.EntityName}}Repository(pgadapter *PostgresAdapter, logger *zap.Logger) *{{.EntityName}}Repository {
	return &{{.EntityName}}Repository{
		pool:     pgadapter.pool,
		logger: logger,
	}
}

func (a *{{.EntityName}}Repository) Create(ctx context.Context, entity *domain.{{.EntityName}}) error {
	query := `INSERT INTO {{.EntityName | toTableName}} ({{range $i, $f := .Fields}}{{if $i}}, {{end}}{{$f.Name | toColumnName}}{{end}}) VALUES ({{range $i, $f := .Fields}}{{if $i}}, {{end}}${{add $i 1}}{{end}})`

	a.logger.Info("Creating entity", zap.String("table", "{{.EntityName | toTableName}}"))

	// TODO: Extract values from entity and execute query
	_, err := a.pool.Exec(ctx, query, entity.Name, entity.Email, entity.Age)
	if err != nil {
		a.logger.Error("Failed to create entity", zap.Error(err))
		return fmt.Errorf("failed to create entity: %w", err)
	}

	return nil
}

