// Test{{.EntityName}}Repository_Create tests the Create method
func Test{{.EntityName}}Repository_Create(t *testing.T) {
	tests := []struct {
		name    string
		entity  *domain.{{.EntityName}}
		setup   func(*MyMockedObject)
		wantErr bool
	}{
		{
			name: "successful create",
			entity: &domain.{{.EntityName}}{
				// Initialize entity fields
			},
			setup: func(m *MyMockedObject) {
				m.On("PutItem", mock.Anything, mock.Anything, mock.Anything).Return(&dynamodb.PutItemOutput{}, nil)
			},
			wantErr: false,
		},
		{
			name: "create with error",
			entity: &domain.{{.EntityName}}{
				// Initialize entity fields
			},
			setup: func(m *MyMockedObject) {
				m.On("PutItem", mock.Anything, mock.Anything, mock.Anything).Return(nil, errors.New("database error"))
			},
			wantErr: true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			mockClient := new(MyMockedObject)
			if tt.setup != nil {
				tt.setup(mockClient)
			}

			repo := &{{.EntityName}}Repository{
				client:    mockClient,
				tableName: "{{.EntityName | toTableName}}",
				logger:    zap.NewNop(),
			}

			// Execute
			ctx := context.Background()
			err := repo.Create(ctx, tt.entity)

			// Assert
			if tt.wantErr {
				assert.Error(t, err)
			} else {
				require.NoError(t, err)
			}

		})
	}
}

