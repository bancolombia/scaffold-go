.PHONY: build build-debug run test test-unit test-integration test-coverage clean install tidy fmt vet lint help

# Binary name and version metadata
BINARY_NAME := {{.Name}}
VERSION    ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo "dev")
BUILD_DATE := $(shell date -u +"%Y-%m-%dT%H:%M:%SZ")
GIT_COMMIT := $(shell git rev-parse --short HEAD 2>/dev/null || echo "unknown")

LDFLAGS := -X main.Version=$(VERSION) \
           -X main.BuildDate=$(BUILD_DATE) \
           -X main.GitCommit=$(GIT_COMMIT)

# Build the binary
build:
	@echo "Building $(BINARY_NAME)..."
	@go build -ldflags "$(LDFLAGS)" -o bin/$(BINARY_NAME) ./cmd
	@echo "Build complete: ./bin/$(BINARY_NAME)"

# Build with optimizations disabled (for debugging)
build-debug:
	@echo "Building $(BINARY_NAME) (debug)..."
	@go build -gcflags="all=-N -l" -ldflags "$(LDFLAGS)" -o bin/$(BINARY_NAME) ./cmd
	@echo "Build complete: ./bin/$(BINARY_NAME)"

# Run the application
run:
	@go run ./cmd

# Run all tests
test:
	@echo "Running tests..."
	@go test ./... -v

# Run only unit tests (fast)
test-unit:
	@echo "Running unit tests..."
	@go test ./... -v -short

# Run integration tests
test-integration:
	@echo "Running integration tests..."
	@go test ./tests/integration/... -v

# Run tests with coverage
test-coverage:
	@echo "Running tests with coverage..."
	@go test ./... -coverprofile=coverage.out -covermode=atomic
	@go tool cover -html=coverage.out -o coverage.html
	@echo "Coverage report: coverage.html"

# Tidy Go module dependencies
tidy:
	@echo "Tidying dependencies..."
	@go mod tidy

# Format source code
fmt:
	@echo "Formatting code..."
	@go fmt ./...

# Static analysis
vet:
	@echo "Running go vet..."
	@go vet ./...

# Run golangci-lint if installed
lint:
	@if command -v golangci-lint >/dev/null 2>&1; then \
		echo "Running golangci-lint..."; \
		golangci-lint run ./...; \
	else \
		echo "golangci-lint not installed; skipping"; \
	fi

# Install the binary to GOPATH/bin
install:
	@echo "Installing $(BINARY_NAME)..."
	@go install -ldflags "$(LDFLAGS)" ./cmd

# Remove build artifacts
clean:
	@echo "Cleaning..."
	@rm -rf bin coverage.out coverage.html
	@echo "Clean complete"

# Show available targets
help:
	@echo "Available targets:"
	@echo "  build            - Build the binary"
	@echo "  build-debug      - Build with debug symbols"
	@echo "  run              - Run the application"
	@echo "  test             - Run all tests"
	@echo "  test-unit        - Run unit tests only (short)"
	@echo "  test-integration - Run integration tests"
	@echo "  test-coverage    - Run tests with coverage report"
	@echo "  tidy             - Tidy Go module dependencies"
	@echo "  fmt              - Format source code"
	@echo "  vet              - Run go vet"
	@echo "  lint             - Run golangci-lint (if installed)"
	@echo "  install          - Install to GOPATH/bin"
	@echo "  clean            - Remove build artifacts"
	@echo "  help             - Show this help"

.DEFAULT_GOAL := build
