package {{.PackageName}}

import (
	"context"

	"github.com/bancolombia/commons-mq-go/mq"
	"go.uber.org/fx"
	"go.uber.org/zap"
)

// {{.ConsumerName}}Consumer listens to messages on the IBM MQ "{{.Queue}}"
// queue using commons-mq-go and dispatches each one to its use cases.
type {{.ConsumerName}}Consumer struct {
{{- range .UseCases}}
	{{.Name}} {{.Type}}
{{- end}}
	logger *zap.Logger
}

// New{{.ConsumerName}}Consumer is the fx constructor for {{.ConsumerName}}Consumer.
func New{{.ConsumerName}}Consumer({{range $i, $uc := .UseCases}}{{if $i}}, {{end}}{{$uc.Name}} {{$uc.Type}}{{end}}{{if .UseCases}}, {{end}}logger *zap.Logger) *{{.ConsumerName}}Consumer {
	return &{{.ConsumerName}}Consumer{
{{- range .UseCases}}
		{{.Name}}: {{.Name}},
{{- end}}
		logger: logger,
	}
}

// Handle is invoked by commons-mq-go for every message received on "{{.Queue}}".
// Returning a non-nil error rolls back the transaction and the message will be
// redelivered (subject to the queue's backout/retry settings).
func (c *{{.ConsumerName}}Consumer) Handle(ctx context.Context, msg *mq.Message) error {
	c.logger.Info("received ibm mq message",
		zap.String("queue", "{{.Queue}}"),
		zap.Int("size", len(msg.Body)),
	)

	// TODO: invoke the appropriate use case(s) using c.<usecase>.Execute(ctx, ...)

	return nil
}

// Register{{.ConsumerName}} starts the IBM MQ listener during fx OnStart and
// stops it cleanly during OnStop.
func Register{{.ConsumerName}}(lc fx.Lifecycle, client *mq.Client, c *{{.ConsumerName}}Consumer, logger *zap.Logger) {
	listener := client.NewListener("{{.Queue}}")
	lc.Append(fx.Hook{
		OnStart: func(ctx context.Context) error {
			logger.Info("starting ibm mq listener", zap.String("queue", "{{.Queue}}"))
			return listener.Start(ctx, c.Handle)
		},
	})
}
