{{if .EnableRateLimiter}}
// Test{{.HandlerName}}_RateLimiter tests rate limiter middleware
func Test{{.HandlerName}}_RateLimiter(t *testing.T) {
	// Setup
	teardown := setupTest(t)
	defer teardown()

	{{range .UseCases}}
	mock{{.}} := new(Mock{{.}})
	{{end}}

	logger := zap.NewNop()
	handler := New{{.HandlerName}}(
		{{range .UseCases}}
		mock{{.}},
		{{end}}
		logger,
	)

	app := handler.GetApp()

	// Make multiple requests to trigger rate limiter
	for i := 0; i < 150; i++ {
		req := httptest.NewRequest("GET", "/", nil)
		resp, err := app.Test(req)
		require.NoError(t, err)
		resp.Body.Close()

		if i >= 100 {
			// Should be rate limited after 100 requests
			assert.Equal(t, fiber.StatusTooManyRequests, resp.StatusCode)
		}
	}
}
{{end}}

