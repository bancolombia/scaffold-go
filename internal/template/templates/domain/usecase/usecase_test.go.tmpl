			input: {{.InputType | testValue}},
			setup: func({{range $i, $dep := .Dependencies}}{{if $i}}, {{end}}m{{$dep.Type}} *Mock{{$dep.Type}}{{$.UseCaseName}}{{end}}) {
				// Setup mock expectations for error case
				{{range .Dependencies}}
				// m{{.Type}}.On("MethodName", mock.Anything).Return(errors.New("mock error"))
				{{end}}
			},
			want:    {{.OutputType | zeroValue}},
			wantErr: true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			// Setup
			teardown := setupTestFor{{.UseCaseName}}UseCase(t)
			defer teardown()

			{{range .Dependencies}}
			mock{{.Type}} := new(Mock{{.Type}}{{$.UseCaseName}})
			{{end}}

			if tt.setup != nil {
				tt.setup({{range $i, $dep := .Dependencies}}{{if $i}}, {{end}}mock{{$dep.Type}}{{end}})
			}

			logger := zap.NewNop()
			uc := New{{.UseCaseName}}UseCase(
				{{range .Dependencies}}
				mock{{.Type}},
				{{end}}
				logger,
			)

			// Execute
			ctx := context.Background()
			got, err := uc.Execute(ctx, tt.input)

			// Assert
			if tt.wantErr {
				assert.Error(t, err)
			} else {
				require.NoError(t, err)
